PORT=8080
DATABASE_URL=postgres://market:market@localhost:5432/market?sslmode=disable
FRONTEND_ORIGIN=http://localhost:3000

FINNHUB_TOKEN=your_finnhub_token_here
FINNHUB_BASE_URL=https://finnhub.io/api/v1

TIINGO_TOKEN=your_tiingo_token_here
TIINGO_BASE_URL=https://api.tiingo.com

TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_or_group_id_here
# Random string; must match the secret_token passed to Telegram setWebhook.
TELEGRAM_WEBHOOK_SECRET=your_random_webhook_secret_here

# REQUIRED for the /reports price-reaction section: SEC EDGAR rejects (403) any
# User-Agent without a contact email. Use "Name email@example.com".
EDGAR_USER_AGENT=YourName your_email@example.com

CALENDAR_WINDOW_DAYS=30
COMPANY_CACHE_TTL_HOURS=24
NEWS_CACHE_TTL_HOURS=6
PRICE_REFRESH_HOUR_UTC=23
